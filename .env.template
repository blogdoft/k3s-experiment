#!/bin/bash

# Ansible Connection Passwords
export ANSIBLE_MORGUL="<your_morgul_password>"
export ANSIBLE_PASSWORD="<your_ansible_password>"
export HOST_NAME="<DNS>"

# POSTGRE Setup
export DATABASE_IMAGE="postgres:14-alpine"
export DATABASE_HOST="<HOST-IP>"
export DATABASE_PORT=5432
export DATABASE_USER="fatlip"
export DATABASE_PASSWORD='<database-password>'
export DATABASE_MAINTENANCE="<default-database>"

# K3s Cluster Token
export K3S_TOKEN="<your_k3s_token>"

# K3s Data Directory (onde o k3s guarda containerd/kubelet/certs)
export K3S_DATA_DIR="/var/lib/rancher/k3s"

# K3s Database Credentials
export K3S_DB_USER="<your_k3s_db_user>"
export K3S_DB_PASSWORD="<your_k3s_db_password>"

# Flagr oauth credentials
export OAUTH2_PROXY_COOKIE_SECRET="<your_oauth2_proxy_cookie_secret>"
export OAUTH2_PROXY_CLIENT_ID="<your_oauth2_proxy_client_id>"
export OAUTH2_PROXY_CLIENT_SECRET="<your_oauth2_proxy_client_secret>"

export KC_ARGOCD_CLIENT_SECRET="<your_oauth2_argocd_secret>"
export KC_FLAGR_CLIENT_SECRET="<your_oauth2_flagr_secret>"

# Keycloak realm import (keycloak/keycloak-export/*-realm.json)
# Client secrets: argocd -> KC_ARGOCD_CLIENT_SECRET, flagr -> OAUTH2_PROXY_CLIENT_SECRET
# (code-brain is a public client and has no secret).
# Realm signing/encryption keys. To reuse an existing install's keys, read them from the
# kc-cluster DB (they must match the certificates kept in the realm JSON):
#   select r.name, c.provider_id, cc.name, cc.value from component_config cc
#     join component c on c.id = cc.component_id join realm r on r.id = c.realm_id
#     where cc.name in ('secret', 'privateKey')
#       and c.provider_id in ('hmac-generated', 'aes-generated', 'rsa-generated', 'rsa-enc-generated');
export KC_K8S_HMAC_SECRET="<k8s realm hmac-generated secret>"
export KC_K8S_AES_SECRET="<k8s realm aes-generated secret>"
export KC_K8S_RSA_PRIVATE_KEY="<k8s realm rsa-generated privateKey>"
export KC_K8S_RSA_ENC_PRIVATE_KEY="<k8s realm rsa-enc-generated privateKey>"
export KC_MASTER_HMAC_SECRET="<master realm hmac-generated secret>"
export KC_MASTER_AES_SECRET="<master realm aes-generated secret>"
export KC_MASTER_RSA_PRIVATE_KEY="<master realm rsa-generated privateKey>"
export KC_MASTER_RSA_ENC_PRIVATE_KEY="<master realm rsa-enc-generated privateKey>"

# Keycloak user password hashes (keycloak/keycloak-export/*-users-0.json).
# Value is the credential's secretData JSON, with the double quotes backslash-escaped, e.g.
#   '{\"value\":\"<hash>\",\"salt\":\"<salt>\",\"additionalParameters\":{}}'
# Read it from the kc-cluster DB:
#   select r.name, u.username, cr.secret_data from credential cr
#     join user_entity u on u.id = cr.user_id join realm r on r.id = u.realm_id where cr.type = 'password';
export KC_K8S_AMIGO_PASSWORD_SECRET_DATA="<k8s realm user amigo secretData>"
export KC_K8S_SAURON_PASSWORD_SECRET_DATA="<k8s realm user sauron secretData>"
export KC_MASTER_ADMIN_PASSWORD_SECRET_DATA="<master realm user admin secretData>"
export KC_MASTER_SAURON_PASSWORD_SECRET_DATA="<master realm user sauron secretData>"

#Forgejo setup
export FORGEJO_DB_NAME="forgejodb"
export FORGEJO_DB_USER="forgejo"
export FORGEJO_DB_PASSWORD=$K3S_DB_PASSWORD

#Open-WebUI setup
export OWUI_DATABASE="<open-webui database name>"
export OWUI_USER="<open-webui database username>"
export OWUI_DBPASS="<open-webui database password>"
